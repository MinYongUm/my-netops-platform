# Copy to .env and edit values. Never commit .env.
# install.sh 가 .env 를 자동 생성한다. 손으로 만들 때만 change_me 를 바꿀 것.

# PostgreSQL
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change_me
POSTGRES_DB=zabbix

# Zabbix (Admin 비밀번호. 첫 설치 때 기본값 zabbix 에서 이 값으로 바뀐다)
ZBX_ADMIN_PASSWORD=change_me

# Host ports (change if already in use on this host)
ZBX_WEB_PORT=8081
GRAFANA_PORT=3000

# Timezone for web UIs
TZ=Asia/Seoul

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me
