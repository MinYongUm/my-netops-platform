{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(docker compose down -v:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(./install.sh:*)",
      "Bash(python3 scripts/inventory.py sites/:*)"
    ],
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 scripts/bootstrap.py --help)",
      "Bash(python3 scripts/inventory.py --help)",
      "Bash(python3 scripts/inventory.py /tmp/:*)",
      "Edit(//tmp/inventory-test/**)",
      "Write(//tmp/inventory-test/**)"
    ]
  }
}
