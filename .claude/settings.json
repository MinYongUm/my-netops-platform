{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(docker compose down -v:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(./install.sh:*)",
      "Bash(python3 scripts/inventory.py:*)"
    ],
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python3 -m py_compile:*)"
    ]
  }
}
