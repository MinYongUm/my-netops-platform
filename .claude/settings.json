{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push:*)",
      "Bash(docker compose down -v:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(./install.sh:*)",
      "Bash(python3 scripts/inventory.py:*)"
    ]
  }
}
